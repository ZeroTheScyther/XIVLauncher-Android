+/* Address range of the x64 emulator DLL (FEX's libarm64ecfex.dll, or xtajit64.dll), found on first use.
+ *
+ * A cooperative suspend must not park a thread while it runs the emulator's own code: the emulator can hold
+ * its internal locks there (FEX's LookupCache), and the suspender then deadlocks as soon as it needs the
+ * emulator to translate new code. Such a thread is left running until the emulator's next doorbell check. */
+static ULONG_PTR emulator_start, emulator_end;
+
+static BOOL is_emulator_image_name( const UNICODE_STRING *name )
+{
+    static const char * const names[] = { "\\libarm64ecfex.dll", "\\xtajit64.dll" };
+    unsigned int i, j, len = name->Length / sizeof(WCHAR);
+
+    for (i = 0; i < ARRAY_SIZE(names); i++)
+    {
+        unsigned int n = strlen( names[i] );
+        if (len < n) continue;
+        for (j = 0; j < n; j++)
+        {
+            WCHAR c = name->Buffer[len - n + j];
+            if (c >= 'A' && c <= 'Z') c += 'a' - 'A';
+            if (c == '/') c = '\\';
+            if (c != (unsigned char)names[i][j]) break;
+        }
+        if (j == n) return TRUE;
+    }
+    return FALSE;
+}
+
+/* Signal-safe: only consults the cached range. */
+static BOOL is_cached_emulator_pc( ULONG_PTR pc )
+{
+    ULONG_PTR end = __atomic_load_n( &emulator_end, __ATOMIC_ACQUIRE );
+    return end && pc >= emulator_start && pc < end;
+}
+
+/* Not signal-safe (queries the virtual memory map); fills the cache on the first emulator address it sees. */
+static BOOL is_emulator_pc( ULONG_PTR pc )
+{
+    char buffer[sizeof(MEMORY_SECTION_NAME) + 1024 * sizeof(WCHAR)];
+    MEMORY_SECTION_NAME *name = (MEMORY_SECTION_NAME *)buffer;
+    MEMORY_BASIC_INFORMATION mbi;
+    const IMAGE_DOS_HEADER *dos;
+    const IMAGE_NT_HEADERS64 *nt;
+
+    if (__atomic_load_n( &emulator_end, __ATOMIC_ACQUIRE )) return is_cached_emulator_pc( pc );
+    if (NtQueryVirtualMemory( GetCurrentProcess(), (void *)pc, MemoryBasicInformation, &mbi, sizeof(mbi), NULL ))
+        return FALSE;
+    if (mbi.Type != MEM_IMAGE || !mbi.AllocationBase) return FALSE;
+    if (NtQueryVirtualMemory( GetCurrentProcess(), mbi.AllocationBase, MemoryMappedFilenameInformation,
+                              name, sizeof(buffer), NULL ))
+        return FALSE;
+    if (!is_emulator_image_name( &name->SectionFileName )) return FALSE;
+
+    dos = mbi.AllocationBase;
+    nt = (const IMAGE_NT_HEADERS64 *)((const char *)dos + dos->e_lfanew);
+    emulator_start = (ULONG_PTR)mbi.AllocationBase;
+    __atomic_store_n( &emulator_end, emulator_start + nt->OptionalHeader.SizeOfImage, __ATOMIC_RELEASE );
+    return TRUE;
+}
